DATABASE_URL=postgresql://user:password@host:port/dbname

# Passcode for entering the app. Leave empty to disable the login screen.
ACCESS_CODE=

# Secret for signing login tokens. If empty, a random one is generated on each
# start, which signs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
