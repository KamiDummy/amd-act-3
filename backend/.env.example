DATABASE_URL=postgresql://user:password@host:port/dbname

# Passcode for entering the app. Leave empty to disable the access check.
ACCESS_CODE=

# Secret for signing login tokens. If empty, a random one is generated on each
# start, which signs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# AMD Token Factory API key. Needed for the scans and the chat; without it those
# endpoints return 503.
TOKEN_FACTORY_API_KEY=

# Optional, shown with their defaults.
# ACCESS_TOKEN_EXPIRE_MINUTES=720
# CORS_ORIGINS=["http://localhost:5173"]
# STORAGE_DIR=storage
# TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# TOKEN_FACTORY_MODEL=Gemma-4-31B-IT
