# Serves the app on DOMAIN with an automatic HTTPS certificate, and passes the API's
# paths to the backend, so the browser talks to one origin.
{$DOMAIN:localhost} {
	encode zstd gzip

	@api path /api/* /auth/* /health /health/* /docs /docs/* /openapi.json
	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		# Hashed build files never change; the page itself is always fetched fresh.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
